{
  "name": "honocord-examples",
  "version": "1.0.0",
  "private": true,
  "description": "Example applications using Honocord",
  "scripts": {
    "dev:worker": "pnpm --filter example-cloudflare-workers dev",
    "dev:custom": "pnpm --filter custom-hono-integration dev",
    "dev:webhook": "pnpm --filter webhook-events dev",
    "start:custom": "pnpm --filter custom-hono-integration start",
    "register:worker": "pnpm --filter example-cloudflare-workers register",
    "register:custom": "pnpm --filter custom-hono-integration register",
    "register:webhook": "pnpm --filter webhook-events register",
    "register:all": "pnpm -r register",
    "deploy:worker": "pnpm --filter example-cloudflare-workers deploy",
    "deploy:webhook": "pnpm --filter webhook-events deploy"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@10.29.2"
}
