{
  "name": "honocord-examples",
  "version": "2.0.0",
  "private": true,
  "description": "Example applications using Honocord",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "dev:workers": "pnpm --filter @example/cloudflare-workers dev",
    "dev:node": "pnpm --filter @example/node-server dev",
    "dev:webhook": "pnpm --filter @example/webhook-events dev",
    "dev:dynamic": "pnpm --filter @example/dynamic-commands dev",
    "register:workers": "pnpm --filter @example/cloudflare-workers register",
    "register:node": "pnpm --filter @example/node-server register",
    "register:dynamic": "pnpm --filter @example/dynamic-commands register",
    "deploy:workers": "pnpm --filter @example/cloudflare-workers deploy",
    "deploy:webhook": "pnpm --filter @example/webhook-events deploy"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.19.0"
}
